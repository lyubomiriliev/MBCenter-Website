# Custom 404 page (Next.js static export generates /404.html)
ErrorDocument 404 /404.html

# Ensure OG image is served with correct MIME type (Facebook/Open Graph)
<Files "og-image.jpg">
  Header set Content-Type "image/jpeg"
</Files>

# 301 redirects: old WordPress URLs → new Next.js paths (for static export in public_html)
RewriteEngine On
RewriteBase /
RewriteCond %{QUERY_STRING} ^page_id=3122$ [NC]
RewriteRule ^$ /bg/contacts? [R=301,L]
RewriteRule ^home/?$ /bg [R=301,L]
RewriteRule ^about-us/?$ /bg/about [R=301,L]
RewriteRule ^contact-us/?$ /bg/contacts [R=301,L]
RewriteRule ^terms/?$ /bg/terms [R=301,L]
RewriteRule ^$ /bg [R=301,L]
